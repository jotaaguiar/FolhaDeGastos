generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id
  username     String @unique
  passwordHash String
  salt         String
  criadoEm    String
}

model UserStore {
  userId String
  key    String
  data   String @db.NVarChar(Max)

  @@id([userId, key])
}
