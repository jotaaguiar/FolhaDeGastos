generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id
  username     String @unique
  email        String?
  passwordHash String
  salt         String
  criadoEm    String
}

model PasswordResetToken {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model UserStore {
  userId String
  key    String
  data   String @db.NVarChar(Max)

  @@id([userId, key])
}
