{
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": ["/api/*", "/*.json", "/*.txt", "/*.ico", "/*.png", "/*.jpg", "/*.jpeg", "/*.gif", "/*.svg"]
  },
  "trailingSlash": "ignore",
  "globalHeaders": [
    {
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      },
      "glob": "**/*.js"
    },
    {
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "glob": "**/*.woff2"
    }
  ],
  "mimeTypes": {
    ".json": "application/json"
  }
}
